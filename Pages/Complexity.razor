@page "/complexity"
@using System.Globalization
@using AlgoMotion.Models
@using AlgoMotion.Services
@using AlgoMotion.Components
@inherits LearningPageBase

<PageTitle>@L("Complexity")</PageTitle>
<section class="stage lesson">
  <h1>@L("Complexity")</h1>
  <p>@L("ComplexityNote")</p>
  <div class="controls">
    <label>@L("Algorithm")
      <select @bind="_algorithm">@foreach (var a in SortAlgorithms.All)
        {
          <option value="@a.Kind">@a.Name</option>
        }</select>
    </label>
    <label>@L("Pattern")
      <select @bind="_pattern">@foreach (var p in new[] { "Random", "Ascending", "Descending" })
        {
          <option value="@p">@L(p)</option>
        }</select>
    </label>
    <label>@L("Reference")
      <select @bind="_curve">
        <option>n</option>
        <option>n log n</option>
        <option>n²</option>
      </select>
    </label>
    <button class="btn" @onclick="Run" disabled="@_busy">@L("Run")</button>
  </div>
  @if (_samples.Count > 0)
  {
    <h2>@SortAlgorithms.Get(_measuredAlgorithm).Name · @L(_measuredPattern)</h2>
    <svg viewBox="0 0 640 300" class="growth-chart" role="img" aria-label="@L("Measured")">
      <line x1="45" y1="260" x2="610" y2="260" stroke="currentColor"/>
      <line x1="45" y1="20" x2="45" y2="260" stroke="currentColor"/>
      <polyline points="@Points(false)" fill="none" stroke="#33d9ff" stroke-width="3"/>
      <polyline points="@Points(true)" fill="none" stroke="#ffc857" stroke-width="2" stroke-dasharray="7 5"/>
      @foreach (var n in _samples.Select(sample => sample.N))
      {
        <g>
          <text x="@X(n)" y="285" fill="currentColor" text-anchor="middle">@n</text>
        </g>
      }
      <g>
        <text x="12" y="24" fill="currentColor">@MaxTotal</text>
        <text x="16" y="262" fill="currentColor">0</text>
      </g>
    </svg>
    <p><span class="legend-measured">● @L("Measured")</span> · <span
        class="legend-reference">— @L("Reference"): @_curve</span></p>
    <table>
      <thead>
      <tr>
        <th>n</th>
        <th>@L("Comparisons")</th>
        <th>@L("Writes")</th>
        <th>@L("Total")</th>
      </tr>
      </thead>
      <tbody>@foreach (var s in _samples)
      {
        <tr>
          <td>@s.N</td>
          <td>@s.Comparisons</td>
          <td>@s.Writes</td>
          <td>@s.Total</td>
        </tr>
      }
      </tbody>
    </table>
  }
</section>

@code {
  private SortAlgorithmKind _algorithm = SortAlgorithmKind.Bubble;
  private SortAlgorithmKind _measuredAlgorithm;
  private string _pattern = "Random";
  private string _measuredPattern = "Random";
  private string _curve = "n²";
  private bool _busy;
  private bool _disposed;
  private readonly List<ComplexitySample> _samples = [];
  private int MaxTotal => Math.Max(1, _samples.Max(s => s.Total));

  private static string X(
    int n
  )
  {
    return (45 + n / 64.0 * 560).ToString("0.##", CultureInfo.InvariantCulture);
  }

  private string Points(
    bool reference
  )
  {
    return string.Join(
      " ",
      _samples.Select(
        s =>
        {
          var y = reference ? ComplexityExperiment.Growth(_curve, s.N) / ComplexityExperiment.Growth(_curve, _samples[^1].N) * _samples[^1].Total : s.Total;
          return $"{X(s.N)},{(260 - y / MaxTotal * 230).ToString("0.##", CultureInfo.InvariantCulture)}";
        }
      )
    );
  }

  private async Task Run()
  {
    _busy = true;
    _samples.Clear();
    _measuredAlgorithm = _algorithm;
    _measuredPattern = _pattern;
    foreach (var n in new[] { 4, 8, 16, 32, 48, 64 })
    {
      await Task.Delay(1);
      if (_disposed) return;
      _samples.Add(ComplexityExperiment.Measure(_measuredAlgorithm, n, _measuredPattern));
      StateHasChanged();
    }

    _busy = false;
  }

  protected override void Dispose(
    bool disposing
  )
  {
    _disposed = true;
    base.Dispose(disposing);
  }

}

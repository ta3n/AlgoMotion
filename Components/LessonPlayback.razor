@using AlgoMotion.Models
@inherits LearningPageBase

<div class="controls lesson-controls">
  <button class="btn btn-play" @onclick="Toggle">@L(_playing ? "Pause" : "Play")</button>
  <button class="btn" @onclick="() => Seek(_index - 1)" disabled="@(_index < 0)">@L("Back")</button>
  <button class="btn" @onclick="() => Seek(_index + 1)" disabled="@(_index >= Count - 1)">@L("Next")</button>
  <button class="btn" @onclick="() => Seek(-1)">@L("Reset")</button>
  <label>@L("Speed") <input type="range" min="1" max="10" @bind="_speed"/></label>
  <label>@L("BreakAt") <input type="number" min="0" max="@Count" @bind="_breakAt"/></label>
  <label class="lesson-timeline">@L("Step") @(_index + 1)/@Count
    <input aria-label="@L("Step")" type="range" min="-1" max="@(Math.Max(-1, Count - 1))"
           value="@_index" @oninput="OnSeek" disabled="@(Count == 0)"/>
  </label>
</div>

@code {
  [Parameter] public int Count { get; set; }
  [Parameter] public EventCallback<int> IndexChanged { get; set; }
  private int _index = -1;
  private int _speed = 2;
  private int _breakAt;
  private bool _playing;
  private CancellationTokenSource? _timer;

  private void Pause()
  {
    _playing = false;
    _timer?.Cancel();
  }

  private async Task Seek(int value)
  {
    Pause();
    _index = Math.Clamp(value, -1, Count - 1);
    await IndexChanged.InvokeAsync(_index);
  }

  private Task OnSeek(ChangeEventArgs args) =>
    int.TryParse(args.Value?.ToString(), out var value) ? Seek(value) : Task.CompletedTask;

  private async Task Toggle()
  {
    if (_playing) { Pause(); return; }
    if (Count == 0) return;
    if (_index >= Count - 1) _index = -1;
    _playing = true;
    var timer = new CancellationTokenSource();
    _timer = timer;
    try
    {
      while (!timer.IsCancellationRequested && _index < Count - 1)
      {
        _index++;
        await IndexChanged.InvokeAsync(_index);
        StateHasChanged();
        if (_breakAt > 0 && _index + 1 == _breakAt) break;
        await Task.Delay(1000 / _speed, timer.Token);
      }
    }
    catch (OperationCanceledException) when (timer.IsCancellationRequested) { /* Paused, sought, or unmounted. */ }
    finally
    {
      if (ReferenceEquals(_timer, timer)) { _playing = false; _timer = null; }
      timer.Dispose();
    }
  }

  protected override void Dispose(bool disposing) { Pause(); base.Dispose(disposing); }
}

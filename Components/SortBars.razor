@using AlgoMotion.Models

<div class="bars-track @(ChartLayout.IsCompact(Bars.Count) ? "is-compact" : "")" style="height:@(ChartLayout.BarAreaHeight)px;">
    @{
        var n = Bars.Count;
        var fontSize = ChartLayout.Num(ChartLayout.BarFontSizePx(n));
    }
    @foreach (var bar in Bars)
    {
        <div @key="bar.Value"
             class="bar @(bar.IsActive ? "bar-active" : "") @(bar.IsSwapping ? "bar-swapping" : "") @(bar.IsSorted ? "bar-sorted" : "")"
             style="left:@(ChartLayout.Pct(ChartLayout.LeftPercent(bar.SlotIndex, n))); width:@(ChartLayout.Pct(ChartLayout.BarWidthPercent(n))); height:@(ChartLayout.BarHeight(bar.Value, MaxValue))px; font-size:@(fontSize)px;"
             title="@bar.Value">
            <span class="bar-value">@bar.Value</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<BarItem> Bars { get; set; } = [];
    [Parameter] public int MaxValue { get; set; } = 1;
}

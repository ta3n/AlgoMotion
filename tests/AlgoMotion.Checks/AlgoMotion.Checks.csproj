<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AlgoMotion</RootNamespace>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Models/**/*.cs" Link="Models/%(Filename)%(Extension)"/>
    <Compile Include="../../Services/**/*.cs" Link="Services/%(Filename)%(Extension)"/>
    <EmbeddedResource Include="../../Resources/*.resx" Link="Resources/%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
